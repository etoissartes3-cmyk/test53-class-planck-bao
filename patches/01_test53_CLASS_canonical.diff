+  double u=z/TEST53_J_DZ;
+  int i=(int)floor(u);
+  if(i<0)i=0;
+  if(i>TEST53_NJ-2)i=TEST53_NJ-2;
+  double t=u-(double)i;
+  return test53_J[i]+t*(test53_J[i+1]-test53_J[i]);
+}
+
+static inline void test53_shape_eval(double z,double *S,double *Sz,double *Szz,double *J) {
+  if(z<=0.0) {
+    int i=0;
+    double dx=0.0;
+    *S=((test53_c0[i]*dx+test53_c1[i])*dx+test53_c2[i])*dx+test53_c3[i];
+    *Sz=(3.0*test53_c0[i]*dx+2.0*test53_c1[i])*dx+test53_c2[i];
+    *Szz=6.0*test53_c0[i]*dx+2.0*test53_c1[i];
+    *J=test53_J[0];
+    return;
+  }
+  if(z>=TEST53_ZMAX) {
+    int i=TEST53_NI-1;
+    double dx=test53_x[TEST53_NS-1]-test53_x[i];
+    *S=((test53_c0[i]*dx+test53_c1[i])*dx+test53_c2[i])*dx+test53_c3[i];
+    *Sz=0.0;
+    *Szz=0.0;
+    *J=test53_J[TEST53_NJ-1];
+    return;
+  }
+  int i=test53_interval(z);
+  double dx=z-test53_x[i];
+  *S=((test53_c0[i]*dx+test53_c1[i])*dx+test53_c2[i])*dx+test53_c3[i];
+  *Sz=(3.0*test53_c0[i]*dx+2.0*test53_c1[i])*dx+test53_c2[i];
+  *Szz=6.0*test53_c0[i]*dx+2.0*test53_c1[i];
+  *J=test53_J_eval(z);
+}
+#endif

+/* Test53 convention: rho_c_dot+3H rho_c=-Q ; V_dot=Q */
+int background_test53_Q(
+                         struct background *pba,
+                         double a,
+                         double H,
+                         double H_prime,
+                         double *Q,
+                         double *Q_prime
+                         ) {
+  double a_rel=a/pba->a_today;
+  double z=1.0/a_rel-1.0;
+  double S,Sz,Szz,J;
+  double zp1,dVdN,d2VdN2;
+  test53_shape_eval(z,&S,&Sz,&Szz,&J);
+  zp1=1.0+z;
+  dVdN=-pba->Omega0_iv*pow(pba->H0,2)*pba->f_dyn_test53*zp1*Sz;
+  *Q=H*dVdN;
+  if(Q_prime!=NULL){
+    d2VdN2=pba->Omega0_iv*pow(pba->H0,2)*pba->f_dyn_test53
+            *(zp1*Sz+zp1*zp1*Szz);
+    *Q_prime=H_prime*dVdN+a*H*H*d2VdN2;
+  }
+  return _SUCCESS_;
+}
+
 
